{
  "name": "oceanups",
  "private": true,
  "version": "0.1.0",
  "description": "SIH 26067 - Interactive Ocean Data Visualization & Model-Observation Intelligence Platform",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/py.mjs -m uvicorn app.api.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload --reload-dir backend/app",
    "dev:web": "npm --prefix web run dev",
    "rehearse": "node web/scripts/rehearse.mjs",
    "smoke:level2": "node web/scripts/smoke-level2.mjs",
    "synth": "node scripts/py.mjs -m app.pipeline.cli synth --profile demo",
    "synth:tiny": "node scripts/py.mjs -m app.pipeline.cli synth --profile tiny",
    "verify": "node scripts/py.mjs -m app.pipeline.cli verify",
    "fetch:real": "node scripts/py.mjs -m app.pipeline.cli fetch-real",
    "fetch:hycom": "node scripts/py.mjs -m app.pipeline.cli fetch-hycom",
    "fetch:erddap": "node scripts/py.mjs -m app.pipeline.cli fetch-erddap",
    "smoke": "node web/scripts/smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
