{
  "name": "oceanups",
  "private": true,
  "version": "0.1.0",
  "description": "SIH 26067 - Interactive Ocean Data Visualization & Model-Observation Intelligence Platform",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "backend/.venv/Scripts/python.exe -m uvicorn app.api.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload --reload-dir backend/app",
    "dev:web": "npm --prefix web run dev",
    "synth": "backend/.venv/Scripts/python.exe -m app.pipeline.cli synth --profile demo",
    "synth:tiny": "backend/.venv/Scripts/python.exe -m app.pipeline.cli synth --profile tiny",
    "verify": "backend/.venv/Scripts/python.exe -m app.pipeline.cli verify"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
